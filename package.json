{
  "name": "folhatec-site-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Site institucional B2B da FolhaTec — base técnica V2.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
