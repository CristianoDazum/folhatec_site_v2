# ------------------------------------------------------------------
# FolhaTec — variáveis de ambiente
# Copie para .env.local em desenvolvimento. Nunca versionar valores reais.
# Nenhuma variável é obrigatória para rodar localmente.
# ------------------------------------------------------------------

# URL pública absoluta, sem barra final (canonical, sitemap, Open Graph, JSON-LD).
# OBRIGATÓRIA em production: https e não local — senão o build falha.
NEXT_PUBLIC_SITE_URL=
# development | staging | production — somente "production" permite indexação.
NEXT_PUBLIC_SITE_ENV=development

# Tracking — deixe vazio para não carregar scripts.
# Se GTM estiver definido, o GA4 deve ser configurado dentro do GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Sanity — sem projectId/dataset o site usa o fallback local tipado.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Opcional (somente leitura). Necessário apenas para dataset privado.
SANITY_API_TOKEN=

# Entrega das solicitações de cotação (server-side).
# Em produção, sem URL, a API retorna erro explícito.
QUOTE_WEBHOOK_URL=
# Usado para assinar o corpo (HMAC SHA-256) no header X-FolhaTec-Signature.
QUOTE_WEBHOOK_SECRET=
